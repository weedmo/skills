{
  "comment": "Rule table for review-gate and qa-gate model choice. Read only by scripts/gate-route.mjs. Change models here, not in skill prose.",
  "families": {
    "claude": {
      "cli": "claude",
      "qa_author": {
        "model": "sonnet"
      },
      "qa_triage": {
        "model": "haiku"
      },
      "review": {
        "model": "sonnet"
      },
      "review_up": {
        "model": "opus",
        "effort": "medium"
      }
    },
    "codex": {
      "cli": "codex",
      "qa_author": {
        "model": "gpt-6.2-sol",
        "effort": "low",
        "agent": "matt-standard"
      },
      "qa_triage": {
        "model": "gpt-6-luna",
        "effort": "low",
        "agent": "matt-fast"
      },
      "review": {
        "model": "gpt-6.2-sol",
        "effort": "medium",
        "agent": "matt-reviewer-lite"
      },
      "review_up": {
        "model": "gpt-6.2-sol",
        "effort": "high",
        "agent": "matt-reviewer"
      }
    },
    "grok": {
      "cli": "grok",
      "qa_triage": {
        "model": "grok-4.7-build-fast"
      },
      "review": {
        "model": "grok-4.7",
        "effort": "medium"
      },
      "review_up": {
        "model": "grok-4.7",
        "effort": "high"
      }
    }
  },
  "grok_priority": {
    "comment": "Grok goes first for these roles while its weekly token use is under cap_pct. Budget: env GROK_WEEKLY_TOKEN_BUDGET, else weekly_token_budget here; unset means Grok is skipped (fail closed).",
    "roles": [
      "review",
      "qa-triage"
    ],
    "cap_pct": 90,
    "weekly_token_budget": null,
    "window_days": 7
  },
  "security_globs": [
    "**/auth/**",
    "**/*oauth*",
    "**/*authn*",
    "**/*authz*",
    "**/*authenticat*",
    "**/*authoriz*",
    "**/*login*",
    "**/*permission*",
    "**/*rbac*",
    "**/*secret*",
    "**/*credential*",
    "**/*crypto*",
    "**/*payment*",
    "**/*billing*",
    "**/migrations/**",
    "**/*.sql",
    "**/.github/workflows/**",
    "**/Dockerfile",
    "**/.env*"
  ]
}
