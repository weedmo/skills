{
  "comment": "Rule table for review-gate, qa-gate and lookup model choice. Read only by scripts/gate-route.mjs. Change models here, not in skill prose.",
  "families": {
    "claude": {
      "cli": "claude",
      "qa_author": {
        "model": "sonnet"
      },
      "qa_triage": {
        "model": "haiku"
      },
      "lookup": {
        "model": "haiku",
        "agent": "Explore"
      },
      "review": {
        "model": "sonnet"
      },
      "review_up": {
        "model": "opus",
        "effort": "medium"
      }
    },
    "codex": {
      "cli": "codex",
      "qa_author": {
        "model": "gpt-6.2-sol",
        "effort": "low",
        "agent": "matt-standard"
      },
      "qa_triage": {
        "model": "gpt-6-luna",
        "effort": "low",
        "agent": "matt-fast"
      },
      "lookup": {
        "model": "gpt-6-luna",
        "effort": "low",
        "agent": "matt-fast"
      },
      "review": {
        "model": "gpt-6.2-sol",
        "effort": "medium",
        "agent": "matt-reviewer-lite"
      },
      "review_up": {
        "model": "gpt-6.2-sol",
        "effort": "high",
        "agent": "matt-reviewer"
      }
    },
    "grok": {
      "cli": "grok",
      "qa_triage": {
        "model": "grok-4.7-build-fast"
      },
      "lookup": {
        "model": "grok-4.7-build-fast"
      }
    }
  },
  "grok_priority": {
    "comment": "Grok goes first for these roles while its weekly token use is under cap_pct. Budget: env GROK_WEEKLY_TOKEN_BUDGET, else weekly_token_budget here, else the budget learned at Grok's last usage-limit error (grok.mjs state). With none yet Grok stays on; a usage-limit error pauses it for pause_hours_after_limit.",
    "roles": [
      "lookup",
      "qa-triage"
    ],
    "cap_pct": 90,
    "weekly_token_budget": null,
    "window_days": 7,
    "pause_hours_after_limit": 24
  },
  "security_globs": [
    "**/auth/**",
    "**/*oauth*",
    "**/*authn*",
    "**/*authz*",
    "**/*authenticat*",
    "**/*authoriz*",
    "**/*login*",
    "**/*permission*",
    "**/*rbac*",
    "**/*secret*",
    "**/*credential*",
    "**/*crypto*",
    "**/*payment*",
    "**/*billing*",
    "**/migrations/**",
    "**/*.sql",
    "**/.github/workflows/**",
    "**/Dockerfile",
    "**/.env*"
  ]
}
